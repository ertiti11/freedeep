# freedeep — example configuration.
# All variables are optional; the defaults shown below are what the code uses.
# Copy this file to .env (loaded automatically from the working directory;
# real environment variables take precedence). A real .env is gitignored.

# ── HTTP server ──
PORT=9655
# Loopback-only by default. Use 0.0.0.0 only when remote access is intentional.
HOST=127.0.0.1
# Optional bearer token required by every non-health endpoint (also accepted
# as an x-api-key header for Anthropic SDKs). Strongly recommended whenever
# HOST is not a loopback address.
# PROXY_API_KEY=replace-with-a-long-random-value
# Read the bearer token from a mounted secret instead of the environment.
# PROXY_API_KEY_FILE=/run/secrets/proxy-api-key
# Fail startup when neither key source is set (enabled by Containerfile).
REQUIRE_PROXY_API_KEY=0
# Browser requests are accepted from loopback origins. Add exact remote UI
# origins as a comma-separated allowlist when needed.
# PROXY_CORS_ORIGINS=https://ui.example.com,http://192.168.1.20:3000

# ── Account auth source ──
# The pool loads DeepSeek accounts from files. Use a single file, a
# comma-separated list, or a directory of *.json files (one account per file).
DEEPSEEK_AUTH_PATH=./deepseek-auth.json
# DEEPSEEK_AUTH_DIR=./data/accounts

# ── Account pool ──
# Cooldown in milliseconds applied to an account after HTTP 401/403/429
# (a 429 Retry-After header takes precedence). Default 600000 = 10 minutes.
DEEPSEEK_ACCOUNT_COOLDOWN_MS=600000

# ── Long agent sessions ──
# Maximum characters (not bytes) sent to DeepSeek Web after compacting old
# context. Lower this if the Web endpoint reports that the content is too long.
DEEPSEEK_MAX_PROMPT_CHARS=80000
# Fresh-session retries for an empty/context-too-long response (0-10).
DEEPSEEK_MAX_RETRIES=2
# Ask DeepSeek to "continue" answers longer than this many characters
# (answers cut with finish_reason=length are always continued). 0 disables.
DEEPSEEK_CONTINUE_OVER_CHARS=25000

# ── Timeouts and limits ──
# Concurrent completions before new requests get 503 + Retry-After.
DEEPSEEK_MAX_CONCURRENT=24
# Wall-clock budget for the retry/continuation loops of one request.
DEEPSEEK_REQUEST_DEADLINE_MS=120000
# Timeout for small upstream calls and for completion response headers.
DEEPSEEK_FETCH_TIMEOUT_MS=60000
# Abort a completion stream that sends no data for this long.
DEEPSEEK_STREAM_IDLE_TIMEOUT_MS=90000

# ── Misc behaviour ──
# Append MEDIA:<path> tags for screenshots referenced in tool results that
# exist on this machine (used by Telegram-style gateways). 0 disables.
DEEPSEEK_MEDIA_INJECTION=1
# Stream the answer token-by-token even when the request declares tools.
# The start of the answer is screened so a tool call is still caught whole
# and never leaks as text; set to 0 to buffer the whole answer first instead.
DEEPSEEK_STREAM_WITH_TOOLS=1
# Return the model's reasoning/thinking to the client. Set to 0 to drop it
# everywhere (no reasoning_content, no [reasoning] block). Reasoning is never
# streamed during a tool turn regardless of this setting.
DEEPSEEK_SHOW_REASONING=1
# Web client headers sent to DeepSeek.
DEEPSEEK_CLIENT_LOCALE=ru
DEEPSEEK_CLIENT_TIMEZONE_OFFSET=14400
# Logging: debug|info|warn|error, text|json.
LOG_LEVEL=info
LOG_FORMAT=text

# ── Startup (deploy / CI) ──
# Set either to 1/true to start the proxy immediately and skip the menu.
# The menu is also skipped automatically when stdin is not a terminal.
NON_INTERACTIVE=0
SKIP_ACCOUNT_MENU=0

# ── Chrome login helper (freedeep login) ──
# Path to a Chrome / Chromium / Edge binary (auto-detected when empty).
CHROME_PATH=
# Remote-debugging port for the login browser (default 9334).
DEEPSEEK_CHROME_PORT=
# Chrome profile directory (default ./.chrome-for-testing-profile-deepseek).
DEEPSEEK_CHROME_PROFILE=
# Keep the Chrome profile between runs (1/true).
DEEPSEEK_KEEP_CHROME_PROFILE=0
# Reuse an already-running Chrome instance (1/true).
DEEPSEEK_REUSE_CHROME=0

# ── Misc ──
# Token for `freedeep import` of a browser cookie export, or for
# `freedeep ask` without an auth file.
# DEEPSEEK_TOKEN=
# Run `freedeep doctor` without network checks (1/true).
# DOCTOR_OFFLINE=0
